[Unit]
Description=NodePanel Master (multi-server management panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nodepanel-master --data-dir=/var/lib/nodepanel --domain=panel.example.com
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
